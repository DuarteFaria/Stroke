{
  "name": "stroke-desktop",
  "productName": "Stroke",
  "version": "0.2.0",
  "description": "Estúdio local de movimento em caiaque",
  "author": "Stroke",
  "private": true,
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --x64 --dir",
    "dist": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never"
  },
  "devDependencies": { "electron": "44.2.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "pt.stroke.studio",
    "asar": true,
    "directories": { "output": "../release" },
    "files": ["*.cjs", "loading.html", "icon.png"],
    "extraResources": [
      { "from": "../LICENSE", "to": "LICENSE.txt" },
      { "from": "../app/desktop-dist", "to": "ui" },
      { "from": "../build/analyzer/stroke-analyzer", "to": "analyzer" }
    ],
    "win": { "icon": "icon.ico", "target": "nsis", "artifactName": "Stroke-${version}-Windows-${arch}-Setup.${ext}" },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "category": "public.app-category.sports",
      "minimumSystemVersion": "14.0",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "Stroke-${version}-macOS-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "deleteAppDataOnUninstall": false }
  }
}
